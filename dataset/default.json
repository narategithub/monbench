{
  "description": "Default data set: one record per component per sample, like an LDMS metric set. Attribute names and units follow the curated_metrics LDMS sampler plugin's flat (non-record) metrics: /proc/meminfo percentages and MemTotal, /proc/loadavg, and the scalar /proc/stat counters. Per-CPU-core and per-network-interface metrics are declared separately -- see dataset/curated_metrics_like.json and design/value-generation.md Sec 6. Every attribute's value is a deterministic, hash-based function of its coordinates, computed generically by core/valuegen.py -- see design/value-generation.md. 'keys' lists the access paths the data set is meant to be queried by; each backend maps them onto its own indexing.",
  "name": "monitoring",
  "attributes": [
    { "name": "timestamp",            "type": "timestamp" },
    { "name": "component_id",         "type": "uint64" },
    { "name": "job_id",               "type": "uint64" },
    { "name": "seq",                  "type": "uint64" },
    { "name": "MemTotal",             "type": "uint64", "range": [16777216, 41943040] },
    { "name": "free",                 "type": "double" },
    { "name": "buff",                 "type": "double" },
    { "name": "cached",               "type": "double" },
    { "name": "active",               "type": "double" },
    { "name": "inactive",             "type": "double" },
    { "name": "dirty",                "type": "double" },
    { "name": "writeback",            "type": "double" },
    { "name": "load1min",             "type": "double" },
    { "name": "load5min",             "type": "double" },
    { "name": "load15min",            "type": "double" },
    { "name": "runnable",             "type": "uint64", "range": [1, 8] },
    { "name": "scheduling_entities",  "type": "uint64", "range": [50, 78] },
    { "name": "newest_pid",           "type": "uint64", "range": [1000, 4194304] },
    { "name": "interrupts",           "type": "double" },
    { "name": "context_sw",           "type": "double" },
    { "name": "fork",                 "type": "double" },
    { "name": "procs_running",        "type": "uint64", "range": [1, 6] },
    { "name": "procs_blocked",        "type": "uint64", "range": [0, 2] }
  ],
  "keys": [
    { "name": "timestamp",     "attrs": ["timestamp"] },
    { "name": "comp_time",     "attrs": ["component_id", "timestamp"] },
    { "name": "job_comp_time", "attrs": ["job_id", "component_id", "timestamp"] }
  ]
}
